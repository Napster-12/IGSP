# Copy to .env and fill in. Never commit .env.

# Flask
SECRET_KEY=change-me-to-a-long-random-string
FLASK_DEBUG=0
# Set to 1 when serving over HTTPS
SESSION_COOKIE_SECURE=0
MAX_UPLOAD_MB=25

# Database — either a full SQLAlchemy URL...
# DATABASE_URL=mysql+pymysql://user:password@localhost:3306/igsp?charset=utf8mb4
# ...or the individual MySQL settings:
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DB=igsp

# Outgoing email. If not configured, verification codes and reset links are
# written to the server log instead.
# MAIL_PROVIDER=ses sends through the Amazon SES API using the server's AWS role
# (af-south-1 has no SES SMTP endpoint); SMTP_FROM is the sender and the SMTP_*
# login settings are ignored. Otherwise SMTP is used (Gmail needs an App Password).
MAIL_PROVIDER=smtp
SES_REGION=af-south-1
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Microsoft SSO for admins (optional). Use your Azure tenant ID, not "common".
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=

# Certificate expiry checks (SARS VAT / B-BBEE): reminders 30 and 7 days before expiry, account
# deactivated once expired. Runs in the app every N hours; 0 disables it (then use cron with
# `flask --app app check-certificates`). PUBLIC_BASE_URL is used for links in those emails.
CERT_CHECK_INTERVAL_HOURS=6
PUBLIC_BASE_URL=https://igsp.staging.icebolethu.co.za

# Supplier registration certificate (issued on approval, valid for one year). Optional signature
# image: static/images/certificate_signature.png. The footer line appears at the bottom of the certificate.
CERTIFICATE_SIGNATORY_NAME=
CERTIFICATE_SIGNATORY_TITLE=Chief Financial Officer
CERTIFICATE_FOOTER=Icebolethu Group · Call Centre 031 208 9102 · supplier_onboarding@icebolethu.co.za

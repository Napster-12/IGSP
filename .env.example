# Copy to .env and fill in. Never commit .env.

# Flask
SECRET_KEY=change-me-to-a-long-random-string
FLASK_DEBUG=0
# Set to 1 when serving over HTTPS
SESSION_COOKIE_SECURE=0
MAX_UPLOAD_MB=25

# Database — either a full SQLAlchemy URL...
# DATABASE_URL=mysql+pymysql://user:password@localhost:3306/igsp?charset=utf8mb4
# ...or the individual MySQL settings:
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DB=igsp

# Outgoing email. If not configured, verification codes and reset links are
# written to the server log instead.
# MAIL_PROVIDER=ses sends through the Amazon SES API using the server's AWS role
# (af-south-1 has no SES SMTP endpoint); SMTP_FROM is the sender and the SMTP_*
# login settings are ignored. Otherwise SMTP is used (Gmail needs an App Password).
MAIL_PROVIDER=smtp
SES_REGION=af-south-1
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Microsoft SSO for admins (optional). Use your Azure tenant ID, not "common".
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=
